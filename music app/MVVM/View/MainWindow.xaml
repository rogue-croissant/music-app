<Window x:Class="Music_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music_app" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d" WindowStyle="None" 
        Title="MainWindow" Height="580" Width="350" ResizeMode="NoResize"
        MinHeight="560" MinWidth="350" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="20" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Border Padding="0" Name="windowBorder" BorderThickness="0" BorderBrush="AliceBlue">
        <Border.Background>
            <ImageBrush ImageSource="/MVVM/View/procreateIcons/Border.png" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
           
            <Border x:Name="topBarBorder" CornerRadius="10,10,0,0"  Padding="5,13,8, 0">
                
                <StackPanel  HorizontalAlignment="Stretch"  Grid.Row="0"  MouseLeftButtonDown="Window_MouseLeftButtonDown">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,2">
                       
                        <Label x:Name="lblPlayerName" Content="Starlight player" HorizontalAlignment="Left" Margin="0,0,120,0" />
                       
                        
                        <ToggleButton x:Name="btnSettings" Style="{StaticResource SettingsButtonStyle}" Tag="{StaticResource SettingsIcon}" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="btnPlaylists" Visibility="Collapsed" Style="{StaticResource PlaylistButtonStyle}" Tag="{StaticResource PlaylistIcon}" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="btnVolume" Visibility="Collapsed" Style="{StaticResource VolumeButtonStyle}" Tag="{StaticResource VolumeIcon}" Margin="0,0,5,0" />

                        <Popup AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=btnVolume, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=btnVolume}"
                               StaysOpen="False"
                               Placement="Bottom"
                               Closed="popupTracks_Closed"
                               >
                            <Border Background="#69558A" CornerRadius="6" BorderBrush="Transparent" BorderThickness="0" Padding="5">
                                <StackPanel Height="105" Width="Auto" Orientation="Vertical" >
                                    <Slider x:Name="volumeSlider" Style="{StaticResource OtherCuteSlider}" Tag="{StaticResource StarIcon}" Minimum="0" Maximum="100" Height="100" Margin="0,0,0,0" VerticalAlignment="Center" Orientation="Vertical">
                                    <Slider.Resources>
                                        <Style TargetType="Thumb">
                                            <EventSetter Event="DragStarted" Handler="Slider_DragStarted"/>
                                            <EventSetter Event="DragCompleted" Handler="VolumeSlider_DragCompleted"/>
                                        </Style>
                                    </Slider.Resources>

                                    </Slider>
                                </StackPanel>
                            </Border>
                        </Popup>
                        
                        <Popup AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=btnPlaylists, Mode=TwoWay}"
                            PlacementTarget="{Binding ElementName=btnPlaylists}"
                            StaysOpen="False"
                            Placement="Bottom"
                            Closed="popupTracks_Closed">
                            <Border Background="green" BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="3">
                                <StackPanel Width="150">
                                    <ListView x:Name="lvPlaylist" ItemsSource="{Binding Playlists}" SelectionChanged="ListView_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>

                                                <TextBlock Text="{Binding Name}"/>

                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Popup AllowsTransparency="True"
                        x:Name="popupTracks"
                        PlacementTarget="{Binding ElementName=lvPlaylist}"
                        Placement="Right"
                        StaysOpen="False">
                            <Border Background="White" 
                            BorderBrush="Gray" 
                            BorderThickness="1" 
                            Padding="10"
                            CornerRadius="6">
                                <StackPanel Width="150">
                                    <ListView x:Name="lvPlaylistTracks" ItemsSource="{Binding PlaylistTracks}" SelectionChanged="lvPlaylistTracks_SelectionChanged">

                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="FontWeight" Value="Normal"/>

                                                <Style.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="LightSkyBlue"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Trigger>

                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="DodgerBlue"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>

                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>

                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Popup>


                        <Popup AllowsTransparency="True"
                            IsOpen="{Binding IsChecked, ElementName=btnSettings, Mode=TwoWay}"
                            PlacementTarget="{Binding ElementName=btnSettings}"
                            StaysOpen="False" 
                            Placement="Bottom">

                            <Border Background="#69558A" 
                            BorderBrush="#373C6F"
                            BorderThickness="1.5" 
                            Padding="0"
                            CornerRadius="6">
                           
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <StackPanel Background="Transparent" Width="Auto" Height="Auto">
                                        <Label Name="lblSetting" Content="{DynamicResource Settings}" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <Label Name="lblUsername" Content="Username" Visibility="Collapsed" Grid.Row="1"/>
                                        <Label Name="lblMode" Content="{DynamicResource Mode}" HorizontalAlignment="Left" Margin="2,2,0,2"  Grid.Row="2"/>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                                            <RadioButton x:Name="rbtnLight" Content="{DynamicResource Light}" Margin="2,0,0,0"  Click="btnEnglish_Click"/>
                                            <RadioButton x:Name="rbtnDark" Content="{DynamicResource Dark}" Margin="2,0,5,0" Click="btnAfrikaans_Click"/>
                                        </StackPanel>
                                        <Label Name="lblLanguage" Content="{DynamicResource Language}"  Grid.Row="4" HorizontalAlignment="Left" Margin="2,2,0,2"/>
                                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                                            <RadioButton x:Name="rbtnEnglish" Content="{DynamicResource English}" Margin="2,0,0,0"  Click="btnEnglish_Click"/>
                                            <RadioButton x:Name="rbtnAfrikaans" Content="{DynamicResource Afrikaans}" Margin="2,0,5,0" Click="btnAfrikaans_Click"/>
                                    </StackPanel>
                                        <Label Name="lblProvider" Content="{DynamicResource Provider}"  Grid.Row="6" HorizontalAlignment="Left" Margin="2,8,0,2"/>
                                    <StackPanel Grid.Row="7" Orientation="Horizontal">
                                            <RadioButton x:Name="rbtnSpotify" Content="Spotify" Margin="2,0,2,0" IsChecked="True" />
                                        </StackPanel>
                                        <Button x:Name="btnLogIn" Content="{DynamicResource Login}" Click="btnLogIn_Click"  Visibility="Visible" Grid.Row="8"  Margin="8"/>
                                        <Button x:Name="btnLogOut" Content="{DynamicResource Logout}" Click="btnLogOut_Click" Visibility="Collapsed" Grid.Row="8" Margin="8"/>
                                    </StackPanel>
                                </Grid>
                    
            </Border>
                        </Popup>



                        <ToggleButton x:Name="btnMinimize" Style="{StaticResource MinButtonStyle}" Tag="{StaticResource MinIcon}" Margin="0,0,5,0"  Click="btnMinimize_Click"/>
                        <ToggleButton x:Name="btnExit" Style="{StaticResource ExitButtonStyle}" Tag="{StaticResource ExitIcon}" Margin="0,0,5,0"  Click="btnExit_Click"/>
                        
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Name="contentBorder"  Grid.Row="1" Grid.RowSpan="2" Padding="5" CornerRadius="0,0,10,10" BorderThickness="0" BorderBrush="Gold">
                
                
                <StackPanel>
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="297" Grid.Row="1" >
                        <Image x:Name="imgPlayerCdState"  Height="150" Width="auto" Source="/MVVM/View/procreateIcons/playerImage.png" Visibility="Visible"  Margin="10,120,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                      

                    </StackPanel>
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Grid.Row="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="auto" Height="Auto" Margin="0,10,0,10" Background="Transparent">
                            <Border CornerRadius="10" Width="65" Height="65">
                                <Border.Background>
                                <ImageBrush x:Name="imgAlbumArt" Stretch="UniformToFill" ImageSource="/MVVM/View/Uramichi oniisan KOTORI.jpg"/>
                                </Border.Background>
                            </Border>
                            <StackPanel Width="160" Height="65" Background="Transparent" >
                                <TextBlock x:Name="myContent" Text="{DynamicResource Connect}" TextWrapping="NoWrap" Padding="7,5,0,0"/>
                                <TextBlock x:Name="txtSongName" Text="{DynamicResource SongName}" FontWeight="Bold" FontSize="15" TextWrapping="NoWrap" Padding="7,5,0,0"/>
                                <TextBlock x:Name="txtArtist" Text="{DynamicResource Artist}" TextWrapping="NoWrap" Padding="7,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Center" Height="Auto" Margin="0,10,0,10">
                            <Button x:Name="btnBackwardSkip" Style="{StaticResource BackButtonStyle}" Tag="{StaticResource BackIcon}" Click="btnBackwardSkip_Click"  Margin="5,0,20,0"/>
                            <Button x:Name="btnPauseAndPlay" Style="{StaticResource PauseButtonStyle}" Tag="{StaticResource PlayIcon}" Click="btnPauseAndPlay_Click"  Margin="5,0,5,0"/>
                            <Button x:Name="btnForwardSkip" Style="{StaticResource ForwardButtonStyle}" Tag="{StaticResource ForwardIcon}"  Click="btnForwardSkip_Click" Margin="20,0,5,0"/>
                        </StackPanel>
                        <Slider x:Name="songProgress" Style="{StaticResource CuteSlider}" Tag="{StaticResource StarIcon}" Minimum="0" Maximum="100" Width="300" Margin="12,0,10,0" >
                            <Slider.Resources>
                                <Style TargetType="Thumb">
                                    <EventSetter Event="DragStarted" Handler="Slider_DragStarted"/>
                                    <EventSetter Event="DragCompleted" Handler="Slider_DragCompleted"/>
                                </Style>
                            </Slider.Resources>
                           
                        </Slider>
                        <StackPanel HorizontalAlignment="Stretch" Height="Auto" Background="Transparent" Margin="15,-5,15,15">
                            <DockPanel LastChildFill="False">
                                <Label x:Name="lblProgress" Content="00:00" Width="auto" DockPanel.Dock="Left"/>
                                <Label x:Name="lblDuration" Content="00:00" Width="auto"  DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                        <wv2:WebView2 x:Name="SpotifyPlayer" HorizontalAlignment="Center" VerticalAlignment="Center" Height="0" Width="0" Visibility="Visible"/>
            </StackPanel>
               
                </StackPanel>
            </Border>
        </Grid>
        
    </Border>
</Window> 
