<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PopupWindows" TargetType="Popup">
        <Setter Property="IsOpen">
            <Setter.Value>
                <Grid Margin="100">
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=CornerRadius}" Stretch="None"/>
                    </Grid.OpacityMask>
                    <Border x:Name="CornerRounder" Background="White" CornerRadius="20">

                        <ScrollViewer VerticalScrollBarVisibility="Visible" Background="White"/>
                    </Border>
                </Grid>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>